// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-outside-of-docker-compose
{
	"name": "CV (LaTeX)",
	"dockerFile": "Dockerfile",
	"customizations": {
		"vscode": {
			"extensions": [
				"james-yu.latex-workshop",
				"eamodio.gitlens",
				"valentjn.vscode-ltex",
				"Gruntfuggly.todo-tree"
			]
		}
	},
	"containerEnv": {
		"IS_SANDBOX": "1"
	},
	"features": {
		"ghcr.io/itsmechlark/features/act:": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/common-utils:": {
			"installZsh": true,
			"configureZshAsDefaultShell": true,
			"installOhMyZsh": true,
			"installOhMyZshConfig": true,
			"upgradePackages": false,
			"username": "automatic",
			"userUid": "automatic",
			"userGid": "automatic"
		},
		"ghcr.io/stuartleeks/dev-container-features/shell-history:": {
			"version": "latest"
		}
	},
	"postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && pre-commit install --install-hooks"
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "docker --version",
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
